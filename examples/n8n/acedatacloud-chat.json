            {
              "id": "0e230e10-c56e-4c61-b6a8-005b50b6d8a6",
              "name": "answer",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            },
            {
              "id": "e68ed73e-2bd8-4a3d-ae6b-5b44c2c6b548",
              "name": "response_id",
