      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.acedata.cloud/openai/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.model, messages: [{ role: 'user', content: $json.prompt }], stream: false, max_tokens: 80 }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "534f922e-7b7c-46da-a9ef-51701db9d73b",
      "name": "AceDataCloud chat",
