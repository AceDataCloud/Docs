                      "message": "internal server error"
                    }
                  }
                }
              }
            },
            "description": "Internal server error."
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "success": false,
                    "error": {
                      "code": "timeout",
                      "message": "extract exceeded timeout"
                    }
                  }
                }
              }
            },
            "description": "Extract exceeded the configured timeout."
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "accept",
            "schema": {
              "enum": [
                "application/json"
              ],
              "type": "string"
            },
            "required": false,
            "description": "Specifies the format of the response from the server."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "url"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "example": "https://www.amazon.com/dp/B0C1234567",
                    "description": "The URL of the web page to extract content from."
                  },
                  "expected_type": {
                    "enum": [
                      "product",
                      "article",
                      "general"
                    ],
                    "type": "string",
                    "description": "Hint about the expected page type to optimize extraction."
                  },
                  "enable_llm": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable optional LLM-based semantic normalization as a final extraction step."
                  },
                  "wait_until": {
                    "enum": [
                      "load",
                      "domcontentloaded",
                      "networkidle",
                      "commit"
                    ],
                    "type": "string",
                    "default": "networkidle",
                    "description": "Page load wait condition."
                  },
                  "timeout": {
                    "type": "number",
                    "default": 30,
                    "description": "Total timeout in seconds for the extract operation."
                  },
                  "delay": {
                    "type": "number",
                    "description": "Extra delay in seconds after the page is loaded, before extraction."
                  },
                  "wait_for_selector": {
                    "type": "string",
                    "description": "CSS selector to wait for before starting extraction."
                  },
                  "block_resources": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "enum": [
                        "image",
                        "font",
                        "media",
                        "stylesheet",
                        "xhr",
                        "fetch"
                      ]
                    },
                    "description": "Resource types to block during page load to speed up extraction."
                  },
                  "headers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    },
                    "description": "Extra HTTP headers to send with the page request."
                  },
                  "user_agent": {
                    "type": "string",
                    "description": "Override the User-Agent header."
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "example": "https://your.server.com/callback",
                    "description": "If provided, the request is processed asynchronously and the final result is POSTed to this URL."
                  }
                }
              }
            }
          },
          "required": true
        }
      }
    },
