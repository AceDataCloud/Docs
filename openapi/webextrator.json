                  },
                  "offset": {
                    "type": "number",
                    "default": 0,
                    "description": "Pagination offset for `retrieve_batch`."
                  },
                  "limit": {
                    "type": "number",
                    "default": 12,
                    "description": "Pagination limit for `retrieve_batch`."
                  }
                }
              }
            }
