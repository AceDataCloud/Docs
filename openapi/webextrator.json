                  }
                }
              }
            },
            "description": "Bad request — invalid payload."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "success": false,
                    "error": {
                      "code": "too_many_requests",
                      "message": "queue is busy"
                    }
                  }
                }
              }
            },
            "description": "Backend queue is busy. Retry later or use callback_url for async processing."
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "success": false,
                    "error": {
