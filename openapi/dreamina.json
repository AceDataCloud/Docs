{
  "openapi": "3.0.0",
  "info": {
    "title": "Dreamina",
    "version": "1.0.0",
    "description": "API reference for Dreamina on Ace Data Cloud."
  },
  "servers": [
    {
      "url": "https://api.acedata.cloud",
      "description": "Ace Data Cloud API"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API token from https://platform.acedata.cloud"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/dreamina/videos": {
      "post": {
        "summary": "Dreamina Video Generation API",
        "description": "Generate an audio-driven talking-photo digital human video (OmniHuman 1.5). Provide a portrait image and a driving audio; the person in the image speaks in sync with the audio.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "image_url",
                  "audio_url"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "omnihuman-1.5"
                    ],
                    "default": "omnihuman-1.5",
                    "description": "Model to use. Currently OmniHuman 1.5."
                  },
                  "image_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public URL of the portrait image. A clear frontal face works best."
                  },
                  "audio_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public URL of the driving audio (mp3/wav). The character lip-syncs to it. Keep it under 60s."
                  },
                  "prompt": {
                    "type": "string",
                    "description": "Optional text prompt to guide expression, emotion, stability and style."
                  },
                  "mask_url": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri"
                    },
                    "description": "Optional subject mask URLs (from object detection) to drive a specific person in a multi-person image."
                  },
                  "callback_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "If provided, the request returns a task_id immediately and the result is delivered to this URL when ready."
                  },
                  "async": {
                    "type": "boolean",
                    "description": "If set to true, the request returns a task_id immediately without requiring a callback_url; poll the corresponding tasks endpoint to retrieve the result."
                  }
                }
              },
              "example": {
                "model": "omnihuman-1.5",
                "image_url": "https://cdn.acedata.cloud/4hfydw.jpg",
                "audio_url": "https://cdn1.suno.ai/1b694cae-8b5f-424f-a5bf-2f27b7697843.mp3"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "success": true,
                    "task_id": "0c0b4d3a-2f1e-4a6b-9c2d-2b3c4d5e6f70",
                    "trace_id": "a9063166-26ed-4451-85b5-54e896817c69",
                    "data": {
                      "task_id": "362b4fed67bd11f1ad1100163e57d510",
                      "status": "done",
                      "video_url": "https://cdn.acedata.cloud/634d760216.mp4",
                      "image_url": "https://cdn.acedata.cloud/4hfydw.jpg",
                      "audio_url": "https://cdn.acedata.cloud/6f7d62b18b.wav"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "bad_request",
                      "message": "image_url is required (a public URL of a portrait image)"
                    },
                    "trace_id": "2efa9340-b21b-4e26-9e14-4aac95f343ab"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "authorization_missing",
                      "message": "Authorization header is missing."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "forbidden",
                      "message": "volcengine access key is invalid or not authorized for omnihuman"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "too_many_requests",
                      "message": "too many requests, please try again later"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": {
                      "code": "api_error",
                      "message": "internal server error, please contact admin"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
