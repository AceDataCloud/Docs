                      180,
                      300
                    ],
                    "type": "number",
                    "description": "The effective duration of the adsl proxy, default is 60 seconds."
                  },
                  "province": {
                    "type": "string",
                    "example": "广东",
                    "description": "The province of the adsl proxy, if not set, it will be random."
                  }
                }
              }
