                    "description": "The type of the adsl proxy, default is http."
                  },
                  "dedup": {
                    "type": "boolean",
                    "example": false,
                    "description": "Whether to deduplicate the adsl proxy, default is false. Also even set to false, the rate of deduplication is still very low."
                  },
                  "number": {
                    "type": "number",
                    "example": 1,
                    "description": "The number of the adsl proxy, default is 1."
                  },
                  "duration": {
                    "enum": [
