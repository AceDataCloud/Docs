                    "enum": [
                      "user",
                      "video"
                    ],
                    "type": "string",
                    "description": "The type of resource you want to search for, usually including users and videos."
                  },
                  "cursor": {
                    "type": "integer",
                    "description": "Post information page turn id, which needs to be returned by cursor in the result."
                  },
                  "region": {
                    "enum": [
                      "us",
                      "jp",
                      "kr",
                      "vn",
                      "br",
                      "ru"
                    ],
                    "type": "string",
                    "description": "Region to search for video resources."
                  },
                  "keywords": {
                    "type": "string",
                    "description": "When searching for user resources, you should enter the user's name, unique_id,When searching for video resources is should be filled in the video name."
                  },
                  "sort_type": {
                    "enum": [
                      0,
                      1,
                      3
                    ],
                    "type": "integer",
                    "description": "Sorting criteria specified when searching for video resources. 0 indicates sorting by keyword relevance, 1 indicates sorting by number of likes, and 3 indicates sorting by publication date."
                  },
                  "publish_time": {
                    "enum": [
                      0,
                      1,
                      24,
                      7,
                      30,
                      90,
                      180
                    ],
                    "type": "integer",
                    "description": "When searching for video resources, specify the release date. 0 indicates unlimited date, 1 indicates expired one day, 7 indicates this week, 30 indicates this month, 90 indicates the past three months, and 180 indicates the past six months."
                  }
                }
              }
            }
          },
          "required": true
        }
