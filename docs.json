{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ace Data Cloud",
  "description": "统一 AI API 平台 — LLM 聊天、图像生成、视频生成、音乐、搜索等。",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/AceDataCloud"
      },
      {
        "label": "平台",
        "href": "https://platform.acedata.cloud"
      }
    ],
    "primary": {
      "type": "button",
      "label": "获取 API Key",
      "href": "https://platform.acedata.cloud"
    }
  },
  "navigation": ["global", "languages"],
  "footer": {
    "socials": {
      "github": "https://github.com/AceDataCloud",
      "x": "https://x.com/AceDataCloud"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "mdx": {
      "auth": {
        "method": "bearer",
        "name": "Authorization"
      }
    },
    "openapi": [
      "/openapi/adsl-http-proxy.json",
      "/openapi/aichat.json",
      "/openapi/claude.json",
      "/openapi/deepseek.json",
      "/openapi/drawai.json",
      "/openapi/face-change.json",
      "/openapi/fish.json",
      "/openapi/flux.json",
      "/openapi/gemini.json",
      "/openapi/grok.json",
      "/openapi/hailuo.json",
      "/openapi/hcaptcha.json",
      "/openapi/identity.json",
      "/openapi/image2text.json",
      "/openapi/kimi.json",
      "/openapi/kling.json",
      "/openapi/localization.json",
      "/openapi/luma.json",
      "/openapi/midjourney.json",
      "/openapi/nano-banana.json",
      "/openapi/openai.json",
      "/openapi/producer.json",
      "/openapi/recaptcha.json",
      "/openapi/seedance.json",
      "/openapi/seedream.json",
      "/openapi/serp.json",
      "/openapi/shorturl.json",
      "/openapi/sora.json",
      "/openapi/suno.json",
      "/openapi/tiktok.json",
      "/openapi/tw.json",
      "/openapi/veo.json",
      "/openapi/wan.json"
    ]
  },
  "variables": {
    "BASE_URL": "https://api.acedata.cloud"
  }
}
